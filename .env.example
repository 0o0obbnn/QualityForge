# QualityForge Stage 4 本地运行模板。复制到 backend/.env 后按需修改。
# SQLite 是单个本地文件，不需要安装 PostgreSQL、Redis 或 Docker。
SQLITE_PATH=data/qualityforge.sqlite3
FRONTEND_DIST=../frontend/dist

APP_ENV=development
JWT_ISSUER=qualityforge-local
JWT_AUDIENCE=qualityforge-web
JWT_TTL_SECONDS=28800

# 本地JWT签名密钥由进程启动时随机生成，不写入文件；服务重启后需重新登录。
# 当前确定性Provider不读取任何模型API Key。
